# Copy this file to `.env` and fill in your own values.
#
# This project supports two auth modes:
# 1) Vertex AI (recommended): use ADC or a service account JSON
# 2) Gemini API key (optional): for non-Vertex usage

# Vertex AI / Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash

# Optional: service account JSON path (otherwise ADC is used)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: Gemini API key auth (not Vertex AI)
# GOOGLE_API_KEY=your-api-key

# Workflow settings
MAX_REFINEMENT_ITERS=3
QUALITY_THRESHOLD=0.80

